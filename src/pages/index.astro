---
/**
 * The free-site wedge homepage. Structure per docs/site-redraft-prompt.md:
 * hero → 5-step scroll film (How it works) → Why free → What's included →
 * FAQ → dual intake → footer. The film keeps the original animation
 * architecture (pinned scrubbed scenes, chapter readout, adaptive chrome,
 * ?jump/__ready dev contract); its content is the free-build journey.
 * Reduced-motion and no-JS visitors get static steps and native forms.
 */
import {
  ANALYTICS,
  BRAND,
  CARE_PLAN_FLOOR,
  CARE_PLAN_DEFAULT,
  CLEARED_SERVICES,
  CONTACT,
  FREE_BUILD,
  NAV,
  NAV_CTA,
  SITE_URL,
} from '../config';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import '../styles/global.css';

const pageTitle = `${BRAND.name} — Free professional websites for home services businesses`;
const canonical = new URL('/', SITE_URL).href;

const hasEndpoint = CONTACT.formEndpoint.length > 0;

const clearedText =
  CLEARED_SERVICES.length > 0
    ? CLEARED_SERVICES.join(', ')
    : 'the growth services that take sustained effort month after month';

const STEPS = [
  {
    id: 'tell-us',
    label: 'STEP 01 / 05 — TELL US',
    eyebrow: 'Step 01 · Tell us',
    title: 'Tell us about your business.',
    sub: 'Three minutes if you’re in a hurry. Fifteen if you want draft one to land close.',
  },
  {
    id: 'draft-one',
    label: 'STEP 02 / 05 — DRAFT ONE',
    eyebrow: 'Step 02 · Draft one',
    title: 'We build draft one. A real working site, not a wireframe.',
    sub: `Within ${FREE_BUILD.draftTimeline} of your confirmed slot.`,
  },
  {
    id: 'revise',
    label: 'STEP 03 / 05 — REVISE',
    eyebrow: 'Step 03 · Revise',
    title: 'We revise it together.',
    sub: 'One revision round — tell us what’s off, we fix it. And anything we broke stays our problem, free.',
  },
  {
    id: 'live',
    label: 'STEP 04 / 05 — LIVE',
    eyebrow: 'Step 04 · Live',
    title: 'It goes live. Your domain. Your property.',
    sub: 'Calls and form fills go straight to you.',
  },
  {
    id: 'yours',
    label: 'STEP 05 / 05 — YOURS',
    eyebrow: 'Step 05 · Yours',
    title: 'Either way, it’s yours.',
    sub: 'Want the ongoing work that keeps the phone ringing? We’ll quote it plainly. If not, you keep the site.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={BRAND.description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={BRAND.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b111c" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <StructuredData />
    {
      ANALYTICS.plausibleDomain && (
        <script
          defer
          data-domain={ANALYTICS.plausibleDomain}
          src="https://plausible.io/js/script.js"
          is:inline
        />
      )
    }
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('film-off');
      }
    </script>
    <noscript>
      <style>
        #filmwrap, .chapter-readout { display: none !important; }
        .static-steps { display: block !important; }
        /* Without JS the wizard chrome is inert and one full form is enough */
        .wiz-head, .wiz-foot, .wiz-final-note { display: none !important; }
        .intake-form[data-intake='detailed'] { display: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#start" class="skip-link">Skip to intake</a>

    <header class="film-header" id="film-header">
      <a href="/" class="fh-wordmark" aria-label={`${BRAND.name} — home`}>
        <span class="fh-mark" aria-hidden="true"></span>
        {BRAND.name}
      </a>
      <nav class="fh-nav" aria-label="Main">
        {
          NAV.filter((n) => n.href !== '/').map((n) => (
            <a href={n.href} class="fh-link">
              {n.label}
            </a>
          ))
        }
        <a href="#why-free" class="fh-skip" id="skip-film">Skip ↓</a>
        <a href={NAV_CTA.href} class="fh-cta">{NAV_CTA.label}</a>
      </nav>
    </header>

    <!-- ============ HERO ============ -->
    <section class="hero scene--dark" aria-label="The offer">
      <div class="noise-layer hero-field" aria-hidden="true"></div>
      <div class="hero-copy">
        <span class="film-eyebrow"
          >HVAC · Plumbing · Electrical · Roofing · Landscaping</span
        >
        <h1 class="film-h">
          A free, professional website for your home services business.
        </h1>
        <p class="film-sub">
          Built in days. You own it outright — domain, files, everything. No
          catch, and we’ll tell you exactly why it’s free.
        </p>
        <div class="btn-row hero-ctas">
          <a href="#start" class="btn btn--primary btn--large">{NAV_CTA.label}</a>
          <a href="#why-free" class="btn btn--ghost btn--large hero-ghost"
            >How is this free?</a
          >
        </div>
        <p class="hero-welcome">
          Home services is our specialty, not a requirement — online stores,
          law firms, any business is welcome.
        </p>
        <p class="scroll-hint" aria-hidden="true">How it works</p>
      </div>
    </section>

    <!-- ============ THE FILM: HOW IT WORKS ============ -->
    <div id="how-it-works" class="anchor-offset"></div>
    <div id="filmwrap">
      <!-- STEP 1 — TELL US -->
      <section class="scene scene--dark" id="s1" aria-label="Step one: tell us about your business">
        <div class="chip-field" aria-hidden="true">
          <span class="chip">Business name</span>
          <span class="chip">HVAC</span>
          <span class="chip">Service area</span>
          <span class="chip">Top 3 services</span>
          <span class="chip">Phone</span>
          <span class="chip">Roofing</span>
          <span class="chip">Photos you have</span>
          <span class="chip">What customers say</span>
          <span class="chip">Plumbing</span>
        </div>
        <div class="scene-copy">
          <span class="film-eyebrow">{STEPS[0].eyebrow}</span>
          <h2 class="film-h">{STEPS[0].title}</h2>
          <p class="film-sub">{STEPS[0].sub}</p>
        </div>
      </section>

      <!-- STEP 2 — DRAFT ONE -->
      <section class="scene scene--dark" id="s2" aria-label="Step two: we build draft one">
        <svg
          class="wireframe"
          viewBox="0 0 560 360"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <rect class="wf-line" x="8" y="8" width="544" height="344" rx="10"></rect>
          <line class="wf-line" x1="8" y1="52" x2="552" y2="52"></line>
          <rect class="wf-line" x="40" y="88" width="300" height="26" rx="4"></rect>
          <rect class="wf-line" x="40" y="130" width="220" height="14" rx="4"></rect>
          <rect class="wf-line wf-cta" x="40" y="170" width="130" height="34" rx="6"></rect>
          <rect class="wf-line" x="40" y="238" width="150" height="80" rx="6"></rect>
          <rect class="wf-line" x="206" y="238" width="150" height="80" rx="6"></rect>
          <rect class="wf-line" x="372" y="238" width="150" height="80" rx="6"></rect>
        </svg>
        <div class="scene-copy">
          <span class="film-eyebrow">{STEPS[1].eyebrow}</span>
          <h2 class="film-h film-h--small">{STEPS[1].title}</h2>
          <p class="mono-tag" id="s2-tag">● FIVE BUSINESS DAYS FROM YOUR CONFIRMED SLOT</p>
        </div>
      </section>

      <!-- STEP 3 — REVISE -->
      <section class="scene scene--dark" id="s3" aria-label="Step three: we revise it together">
        <div class="scene-copy">
          <span class="film-eyebrow">{STEPS[2].eyebrow}</span>
          <h2 class="film-h film-h--small">{STEPS[2].title}</h2>
          <div class="edits" aria-hidden="true">
            <p class="edit">
              <span class="edit-old"
                >Serving the greater area<span class="strike"></span></span
              >
              <span class="edit-new">Serving Fresno &amp; Clovis</span>
            </p>
            <p class="edit">
              <span class="edit-old"
                >We do it all<span class="strike"></span></span
              >
              <span class="edit-new">AC repair · installs · tune-ups</span>
            </p>
            <p class="edit">
              <span class="edit-old"
                >Contact us<span class="strike"></span></span
              >
              <span class="edit-new">Call now — answered 24/7</span>
            </p>
          </div>
          <p class="film-sub" id="s3-sub">{STEPS[2].sub}</p>
        </div>
      </section>

      <!-- STEP 4 — LIVE -->
      <section class="scene scene--dark" id="s4" aria-label="Step four: it goes live">
        <svg
          class="sigwave"
          viewBox="0 0 1200 240"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <path
            class="sigpath sigpath--halo"
            d="M0,120 L200,120 L228,74 L256,166 L284,96 L312,144 L340,120 L520,120 L548,74 L576,166 L604,96 L632,144 L660,120 L840,120 L868,74 L896,166 L924,96 L952,144 L980,120 L1200,120"
          ></path>
          <path
            class="sigpath sigpath--glow"
            d="M0,120 L200,120 L228,74 L256,166 L284,96 L312,144 L340,120 L520,120 L548,74 L576,166 L604,96 L632,144 L660,120 L840,120 L868,74 L896,166 L924,96 L952,144 L980,120 L1200,120"
          ></path>
          <path
            class="sigpath sigpath--core"
            d="M0,120 L200,120 L228,74 L256,166 L284,96 L312,144 L340,120 L520,120 L548,74 L576,166 L604,96 L632,144 L660,120 L840,120 L868,74 L896,166 L924,96 L952,144 L980,120 L1200,120"
          ></path>
        </svg>
        <div class="scene-copy">
          <span class="film-eyebrow">{STEPS[3].eyebrow}</span>
          <h2 class="film-h film-h--small" id="s4-h">{STEPS[3].title}</h2>
          <p class="film-sub" id="s4-sub">{STEPS[3].sub}</p>
          <p class="mono-tag" id="s4-tag">● LIVE</p>
        </div>
      </section>

      <!-- STEP 5 — YOURS -->
      <section class="scene scene--dark" id="s5" aria-label="Step five: you keep the site either way">
        <div class="paper-flood" aria-hidden="true"></div>
        <div class="scene-copy ch5-copy">
          <span class="film-eyebrow film-eyebrow--ink">{STEPS[4].eyebrow}</span>
          <h2 class="wm" aria-label={STEPS[4].title}>
            <span class="brand-square" aria-hidden="true"></span
            ><span class="wm-chars" aria-hidden="true"
              >{'Yours.'.split('').map((c) => <span class="wm-char">{c}</span>)}</span
            >
          </h2>
          <p class="ch5-tag">{STEPS[4].title}</p>
          <p class="ch5-line">{STEPS[4].sub}</p>
          <div class="btn-row ch5-ctas">
            <a href="#start" class="btn btn--primary btn--large"
              >{NAV_CTA.label}</a
            >
          </div>
        </div>
      </section>
    </div>

    <!-- Static steps for reduced-motion / no-JS -->
    <section class="static-steps section" aria-label="How it works">
      <div class="container container--narrow">
        <span class="eyebrow">How it works</span>
        <h2>Five steps, start to live.</h2>
        <ol class="steps" style="margin-top: var(--space-5);">
          {
            STEPS.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p class="muted">{s.sub}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <div class="chapter-readout" id="readout" aria-hidden="true">
      <span class="ro-label" id="ro-label">{STEPS[0].label}</span>
      <span class="ro-bar"><span class="ro-fill" id="ro-fill"></span></span>
    </div>

    <main id="content">
      <!-- ============ WHY FREE ============ -->
      <section class="section" id="why-free">
        <div class="container container--narrow">
          <span class="eyebrow">Why free</span>
          <h2>Why would anyone build websites for free?</h2>
          <div class="stack" style="margin-top: var(--space-4);">
            <p class="lede">
              Because the economics changed. AI-assisted development means a
              site that used to take an agency six weeks takes us days. Our
              real business is the ongoing work — {clearedText}. Some of the
              businesses we build free sites for hire us for that. Enough
              that the math works.
            </p>
            <p class="lede">
              The free site is our audition, not a trap. You keep it either
              way. We’ll put the terms in writing — one page, plain English —
              before we start. <a href="/terms/">Read them now</a> if you
              like.
            </p>
          </div>
        </div>
      </section>

      <!-- ============ WHAT'S INCLUDED ============ -->
      <section class="section section--rule" id="included">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Scope, in writing</span>
            <h2>What the free build includes — and what it doesn’t.</h2>
          </div>
          <div class="grid grid--2">
            <div class="card">
              <h3>Free build includes</h3>
              <ul class="checklist">
                {FREE_BUILD.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="card">
              <h3>Not included free — quoted plainly if you want it</h3>
              <ul class="checklist checklist--neutral">
                {FREE_BUILD.notIncludedFree.map((item) => <li>{item}</li>)}
              </ul>
              <p class="muted" style="margin-top: var(--space-3); font-size: var(--text-sm);">
                Care plans from {CARE_PLAN_FLOOR.price}, cancel anytime —
                details on the <a href="/services/">services page</a>.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FAQ ============ -->
      <section class="section section--rule" id="faq">
        <div class="container container--narrow">
          <div class="section-head">
            <span class="eyebrow">FAQ</span>
            <h2>The questions a sensible skeptic asks.</h2>
          </div>
          <details class="faq">
            <summary>What’s the catch?</summary>
            <div class="faq-body">
              <p>
                There isn’t one you’ll find later. The site is yours —
                domain, files, content. We build free because some clients
                hire us afterward for ongoing work. That’s the entire model,
                and we’d rather tell you than have you wonder.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>Do I have to host with you?</summary>
            <div class="faq-body">
              <p>
                No. At launch, everything moves into accounts in your name —
                code, hosting, domain. Running any website costs hosting:
                roughly $0–20 a month if you handle it yourself, or a care
                plan from {CARE_PLAN_FLOOR.price.replace('/month', ' a month')}
                and we handle it — the {CARE_PLAN_DEFAULT.name} at
                {CARE_PLAN_DEFAULT.price.replace('/month', ' a month')} adds
                monthly content edits. The build is free either way, and if
                you ever leave a plan we hand everything over within 5
                business days at no charge.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>Is this a template with my logo on it?</summary>
            <div class="faq-body">
              <p>
                No. Each site is built from your intake — your services, your
                area, your photos. Modern code, not a page-builder account
                you’re locked into.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>What if the draft misses?</summary>
            <div class="faq-body">
              <p>
                One revision round is included — the “change it” pass:
                structure, layout, what the site does. Broken is a different
                thing entirely: if something we built doesn’t work, that’s a
                bug, and fixing it is free for 60 days after launch without
                touching your revision. A bug we caused is never your bill.
                And if after the revision it’s still not you — walk away.
                You’ve lost nothing.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>How do you make money if I never buy anything?</summary>
            <div class="faq-body">
              <p>
                On you, we don’t — with one disclosed exception: if you ask
                us to set up online payments, we earn a small platform
                share of each transaction, shown to you in writing before
                anything goes live. Otherwise, across everyone we build
                for, enough hire us for ongoing work that it works out.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>Do I have to get on a sales call?</summary>
            <div class="faq-body">
              <p>
                No. Submit the form, get the draft. We’ll talk when there’s
                something to look at.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>I’m not in home services — can I still get one?</summary>
            <div class="faq-body">
              <p>
                Yes. Home services is our focus, not a fence — law firms,
                online stores, restaurants, any real business. We’d be glad
                to build yours. That includes stores: product pages and
                checkout, wired to a payment account in your own name, like
                everything else we hand over. One honest note: a store done
                right can take longer than a brochure site, so store builds
                get a written timeline when we confirm your slot.
              </p>
            </div>
          </details>
          <details class="faq">
            <summary>How fast?</summary>
            <div class="faq-body">
              <p>
                First working draft within {FREE_BUILD.draftTimeline} of
                your confirmed slot. We confirm within one business day of
                your intake — and if the month is full, you’ll know then,
                not after.
              </p>
            </div>
          </details>
          {
            /* Capacity FAQ renders only once FREE_BUILD.capacityPerMonth is a
               real, enforced number (DECISION 5). An invented number would be
               fake scarcity, which this site bans. */
            FREE_BUILD.capacityPerMonth !== null && (
              <details class="faq">
                <summary>How many of these do you do?</summary>
                <div class="faq-body">
                  <p>
                    {FREE_BUILD.capacityPerMonth} free builds a month. When
                    the month is full, you go on next month's list.
                  </p>
                </div>
              </details>
            )
          }
        </div>
      </section>

      {
        /* PROOF SECTION — intentionally absent until real proof exists.
           When there are live client sites with written permission, add a
           section here: 2-3 launched-site cards (screenshot, trade, link)
           and nothing invented — no testimonials without written consent,
           no counts, no ratings. */
      }

      <!-- ============ INTAKE ============ -->
      <section class="section section--rule" id="start">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Start</span>
            <h2>Two ways in. Both end with a real draft.</h2>
            <p class="muted">
              No sales call, no deposit, no card. Pick the form that matches
              the time you have. Your answers go to our inbox to build your
              draft — <a href="/privacy/">the privacy policy</a>, in plain
              English.
            </p>
          </div>

          <div class="wiz-chooser" data-wiz-chooser>
            <button type="button" class="card wiz-choice" data-choose="quickstart">
              <h3>Quickstart</h3>
              <p class="muted">
                Enough for us to build draft one. Best if you want to see
                something fast.
              </p>
              <span class="wiz-choice__meta">10 quick questions · ~3 minutes →</span>
            </button>
            <button type="button" class="card wiz-choice" data-choose="detailed">
              <h3>Detailed</h3>
              <p class="muted">
                The more you give us, the closer draft one lands.
              </p>
              <span class="wiz-choice__meta">19 questions · 10–15 minutes →</span>
            </button>
          </div>

          <div class="intake-stack">
            <!-- Path A: Quickstart -->
            <form
              class="card intake-form wiz-form"
              method="POST"
              action={hasEndpoint ? CONTACT.formEndpoint : undefined}
              data-intake="quickstart"
              novalidate
            >
              <div class="wiz-head">
                <button type="button" class="wiz-back" aria-label="Go back">←</button>
                <span class="wiz-count" data-wiz-count>1 / 10</span>
                <span class="wiz-track"><span class="wiz-fill" data-wiz-fill></span></span>
              </div>
              <h3 class="wiz-title">Quickstart — 3 minutes</h3>
              <p class="muted intake-blurb">
                Enough for us to build draft one. Best if you want to see
                something fast.
              </p>
              <input type="hidden" name="form_type" value="quickstart" />
              <p class="hp-field" aria-hidden="true">
                <label for="qs-website-hp">Leave this field empty</label>
                <input
                  id="qs-website-hp"
                  type="text"
                  name="company_website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </p>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-name">Business name *</label>
                  <input id="qs-name" name="business_name" type="text" required />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-trade">What you do *</label>
                  <select id="qs-trade" name="trade" required>
                    <option value="">Choose one…</option>
                    <option>HVAC</option>
                    <option>Plumbing</option>
                    <option>Electrical</option>
                    <option>Roofing</option>
                    <option>Landscaping</option>
                    <option>Law firm</option>
                    <option>Online store / e-commerce</option>
                    <option>Other</option>
                  </select>
                </div>
                <div class="field">
                  <label for="qs-trade-other">If other — what?</label>
                  <input id="qs-trade-other" name="trade_other" type="text" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-area">Service area *</label>
                  <input
                    id="qs-area"
                    name="service_area"
                    type="text"
                    required
                    placeholder="e.g. Fresno & Clovis"
                  />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-phone">Phone *</label>
                  <input id="qs-phone" name="phone" type="tel" required autocomplete="tel" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-email">Email *</label>
                  <input id="qs-email" name="email" type="email" required autocomplete="email" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-url">Current website (if any)</label>
                  <input id="qs-url" name="current_website" type="url" placeholder="https://" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-services">Your top 3 services *</label>
                  <textarea id="qs-services" name="top_services" rows="2" required></textarea>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-like">One thing customers say they like about you *</label>
                  <textarea id="qs-like" name="customers_like" rows="2" required></textarea>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-must">Anything the site must include</label>
                  <textarea id="qs-must" name="must_include" rows="2"></textarea>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="qs-refs">Any sites you like — or can’t stand</label>
                  <textarea
                    id="qs-refs"
                    name="reference_sites"
                    rows="2"
                    placeholder="URLs are fine, with a word on why — either direction helps"
                  ></textarea>
                </div>
              </div>
              <div class="wiz-step wiz-step--final">
                <p class="wiz-final-note">
                  That’s everything we need for draft one.
                </p>
                <p class="form-error" role="alert" hidden>
                  A few required fields are missing — tap back to fill them.
                </p>
                <button
                  type="submit"
                  class="btn btn--primary btn--large intake-submit"
                  disabled={!hasEndpoint}
                >
                  Send it — build my draft
                </button>
              </div>
              <div class="wiz-foot">
                <button type="button" class="btn btn--primary wiz-next">
                  Next →
                </button>
              </div>
              {
                !hasEndpoint && (
                  <p class="muted intake-fallback">
                    Intake opens shortly. Today, email
                    <a href={`mailto:${CONTACT.email}`}> {CONTACT.email}</a>
                    with these answers and we’ll take it from there.
                  </p>
                )
              }
              <p class="form-success" role="status" hidden>
                Got it. You’ll hear from us within 1 business day with your
                draft timeline.
              </p>
            </form>

            <!-- Path B: Detailed -->
            <form
              class="card intake-form wiz-form"
              method="POST"
              action={hasEndpoint ? CONTACT.formEndpoint : undefined}
              data-intake="detailed"
              novalidate
            >
              <div class="wiz-head">
                <button type="button" class="wiz-back" aria-label="Go back">←</button>
                <span class="wiz-count" data-wiz-count>1 / 19</span>
                <span class="wiz-track"><span class="wiz-fill" data-wiz-fill></span></span>
              </div>
              <h3 class="wiz-title">Detailed — 10–15 minutes</h3>
              <p class="muted intake-blurb">
                The more you give us, the closer draft one lands.
              </p>
              <input type="hidden" name="form_type" value="detailed" />
              <p class="hp-field" aria-hidden="true">
                <label for="dt-website-hp">Leave this field empty</label>
                <input
                  id="dt-website-hp"
                  type="text"
                  name="company_website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </p>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-name">Business name *</label>
                  <input id="dt-name" name="business_name" type="text" required />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-trade">What you do *</label>
                  <select id="dt-trade" name="trade" required>
                    <option value="">Choose one…</option>
                    <option>HVAC</option>
                    <option>Plumbing</option>
                    <option>Electrical</option>
                    <option>Roofing</option>
                    <option>Landscaping</option>
                    <option>Law firm</option>
                    <option>Online store / e-commerce</option>
                    <option>Other</option>
                  </select>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-area">Service area *</label>
                  <input id="dt-area" name="service_area" type="text" required />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-phone">Phone *</label>
                  <input id="dt-phone" name="phone" type="tel" required autocomplete="tel" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-email">Email *</label>
                  <input id="dt-email" name="email" type="email" required autocomplete="email" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-url">Current website (if any)</label>
                  <input id="dt-url" name="current_website" type="url" placeholder="https://" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-services">Your top 3 services *</label>
                  <textarea id="dt-services" name="top_services" rows="2" required></textarea>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-like">One thing customers say they like about you *</label>
                  <textarea id="dt-like" name="customers_like" rows="2" required></textarea>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-brand">Logo / brand colors</label>
                  <input
                    id="dt-brand"
                    name="brand_assets"
                    type="text"
                    placeholder="Link to a logo file, or describe your colors"
                  />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-photos">Photos you have the right to use</label>
                  <input
                    id="dt-photos"
                    name="photo_links"
                    type="text"
                    placeholder="Google Drive / Dropbox link is perfect"
                  />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-pages">Pages you want</label>
                  <input id="dt-pages" name="pages_wanted" type="text" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-licenses">Licenses / certifications you hold</label>
                  <input id="dt-licenses" name="licenses" type="text" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-testimonials"
                    >Testimonials you have written permission to use</label
                  >
                  <textarea id="dt-testimonials" name="testimonials" rows="2"></textarea>
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-booking">Booking or scheduling tool you use</label>
                  <input id="dt-booking" name="booking_tool" type="text" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-hours">Hours &amp; locations</label>
                  <input id="dt-hours" name="hours_locations" type="text" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-likes">1–2 sites you like the look of</label>
                  <input
                    id="dt-likes"
                    name="reference_sites_liked"
                    type="text"
                    placeholder="URLs are fine — a note on why helps"
                  />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-dislikes">Sites that turn you off</label>
                  <input
                    id="dt-dislikes"
                    name="reference_sites_disliked"
                    type="text"
                    placeholder="What made you close them?"
                  />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-domain">Do you own a domain already?</label>
                  <input id="dt-domain" name="owns_domain" type="text" placeholder="Yes/no — which one?" />
                </div>
              </div>
              <div class="wiz-step">
                <div class="field">
                  <label for="dt-gbp">Do you have a Google Business Profile?</label>
                  <input id="dt-gbp" name="has_gbp" type="text" placeholder="Yes / no / not sure" />
                </div>
              </div>
              <div class="wiz-step wiz-step--final">
                <p class="wiz-final-note">
                  That’s everything — draft one will land close.
                </p>
                <p class="form-error" role="alert" hidden>
                  A few required fields are missing — tap back to fill them.
                </p>
                <button
                  type="submit"
                  class="btn btn--primary btn--large intake-submit"
                  disabled={!hasEndpoint}
                >
                  Send it — build my draft
                </button>
              </div>
              <div class="wiz-foot">
                <button type="button" class="btn btn--primary wiz-next">
                  Next →
                </button>
              </div>
              {
                !hasEndpoint && (
                  <p class="muted intake-fallback">
                    Intake opens shortly. Today, email
                    <a href={`mailto:${CONTACT.email}`}> {CONTACT.email}</a>
                    with these answers and we’ll take it from there.
                  </p>
                )
              }
              <p class="form-success" role="status" hidden>
                Got it. You’ll hear from us within 1 business day with your
                draft timeline.
              </p>
            </form>
          </div>
          <p class="muted" style="margin-top: var(--space-4); font-size: var(--text-sm);">
            Not in home services? Same offer, same terms — law firms, online
            stores, restaurants, any real business. Pick your line in the
            form or write it in.
          </p>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline src="/vendor/gsap.min.js"></script>
    <script is:inline src="/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/vendor/lenis.min.js"></script>
    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const JUMP = new URLSearchParams(location.search).get('jump');
        // We position hash/jump landings ourselves after the pins inflate —
        // the browser's own restoration would fight the correction.
        if (JUMP !== null || location.hash) history.scrollRestoration = 'manual';

        // ---- Intake wizard (runs film or not) ----
        const chooser = document.querySelector('[data-wiz-chooser]');
        const wizForms = Array.from(document.querySelectorAll('.wiz-form'));
        const intakeLoadedAt = performance.now();

        const wizState = new Map(); // form -> current step index

        function stepsOf(form) {
          return Array.from(form.querySelectorAll('.wiz-step'));
        }

        function setStep(form, index) {
          const steps = stepsOf(form);
          const i = Math.max(0, Math.min(index, steps.length - 1));
          wizState.set(form, i);
          steps.forEach((s, n) => s.classList.toggle('is-current', n === i));
          const isFinal = i === steps.length - 1;
          const count = form.querySelector('[data-wiz-count]');
          const fill = form.querySelector('[data-wiz-fill]');
          count.textContent = isFinal ? 'Send it' : `${i + 1} / ${steps.length - 1}`;
          fill.style.width = ((i + 1) / steps.length) * 100 + '%';
          form.querySelector('.wiz-foot').style.display = isFinal ? 'none' : '';
          const focusable = steps[i].querySelector('input, select, textarea');
          if (focusable) focusable.focus({ preventScroll: true });
        }

        function openForm(type) {
          chooser.classList.add('is-hidden');
          wizForms.forEach((f) => {
            const active = f.dataset.intake === type;
            f.classList.toggle('is-active', active);
            if (active) setStep(f, wizState.get(f) ?? 0);
          });
        }

        function closeToChooser() {
          chooser.classList.remove('is-hidden');
          wizForms.forEach((f) => f.classList.remove('is-active'));
          chooser.querySelector('[data-choose]').focus({ preventScroll: true });
        }

        function validateStep(form) {
          const steps = stepsOf(form);
          const current = steps[wizState.get(form) ?? 0];
          let ok = true;
          current.querySelectorAll('[required]').forEach((input) => {
            const bad = !input.value.trim();
            input.toggleAttribute('aria-invalid', bad);
            if (bad) ok = false;
          });
          return ok;
        }

        document.querySelectorAll('[data-choose]').forEach((btn) => {
          btn.addEventListener('click', () => openForm(btn.dataset.choose));
        });

        wizForms.forEach((form) => {
          form.querySelector('.wiz-next').addEventListener('click', () => {
            if (validateStep(form)) setStep(form, (wizState.get(form) ?? 0) + 1);
          });
          form.querySelector('.wiz-back').addEventListener('click', () => {
            const i = wizState.get(form) ?? 0;
            if (i === 0) closeToChooser();
            else setStep(form, i - 1);
          });
          // Enter advances (except in textareas and on the final step)
          form.addEventListener('keydown', (ev) => {
            if (ev.key !== 'Enter' || ev.target.tagName === 'TEXTAREA') return;
            const isFinal =
              (wizState.get(form) ?? 0) === stepsOf(form).length - 1;
            if (!isFinal) {
              ev.preventDefault();
              if (validateStep(form)) setStep(form, (wizState.get(form) ?? 0) + 1);
            }
          });

          form.addEventListener('submit', (ev) => {
            const errorEl = form.querySelector('.form-error');
            const successEl = form.querySelector('.form-success');
            // Honeypot + time-to-submit: quietly drop bot submissions.
            // (No human finishes a multi-step intake in under 5 seconds.)
            if (
              form.querySelector('[name="company_website"]').value ||
              performance.now() - intakeLoadedAt < 5000
            ) {
              ev.preventDefault();
              return;
            }
            // Full-form validation (steps were validated on Next; re-check all).
            let valid = true;
            form.querySelectorAll('[required]').forEach((input) => {
              const bad = !input.value.trim();
              input.toggleAttribute('aria-invalid', bad);
              if (bad) valid = false;
            });
            if (!valid) {
              ev.preventDefault();
              errorEl.hidden = false;
              // Jump the wizard back to the first invalid step.
              const steps = stepsOf(form);
              const badStep = steps.findIndex((s) => s.querySelector('[aria-invalid]'));
              if (badStep >= 0) setStep(form, badStep);
              return;
            }
            errorEl.hidden = true;
            const action = form.getAttribute('action');
            if (!action) {
              ev.preventDefault();
              return; // endpoint not configured; fallback note is visible
            }
            // Enhance: fetch POST + inline confirmation (native POST works without JS).
            ev.preventDefault();
            const btn = form.querySelector('.intake-submit');
            btn.disabled = true;
            fetch(action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            })
              .then((r) => {
                if (!r.ok) throw new Error('submit failed');
                form
                  .querySelectorAll('.wiz-step, .wiz-head, .wiz-foot, .intake-blurb, .wiz-title')
                  .forEach((el) => (el.style.display = 'none'));
                successEl.hidden = false;
              })
              .catch(() => {
                btn.disabled = false;
                errorEl.textContent =
                  'That didn’t go through. Try again, or email us directly.';
                errorEl.hidden = false;
              });
          });
        });

        if (reduced) {
          document.documentElement.classList.add('film-off');
          window.__ready = true;
          return;
        }

        gsap.registerPlugin(ScrollTrigger);

        let lenis = null;
        if (JUMP === null && typeof Lenis !== 'undefined') {
          lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((t) => lenis.raf(t * 1000));
          gsap.ticker.lagSmoothing(0);
        }

        // Hero ambient word field — trades and intake phrases, quiet texture.
        const FIELD_WORDS = [
          'HVAC', 'PLUMBING', 'ELECTRICAL', 'ROOFING', 'LANDSCAPING',
          'SERVICE AREA', 'FIRST DRAFT', 'YOUR DOMAIN', 'CLICK TO CALL',
          'BUILT IN DAYS', 'MOBILE FIRST', 'YOUR PROPERTY',
        ];
        const heroField = document.querySelector('.hero-field');
        const fieldCount = innerWidth < 640 ? 8 : 14;
        for (let i = 0; i < fieldCount; i++) {
          const span = document.createElement('span');
          span.className = 'nw' + (i % 3 === 0 ? ' nw--stroke' : '');
          span.textContent = FIELD_WORDS[i % FIELD_WORDS.length];
          let x, y;
          do {
            x = 3 + Math.random() * 90;
            y = 3 + Math.random() * 90;
          } while (Math.abs(x - 50) < 27 && Math.abs(y - 48) < 26);
          span.style.left = x + '%';
          span.style.top = y + '%';
          span.style.fontSize = 0.75 + Math.random() * 0.8 + 'rem';
          span.style.transform = 'rotate(' + (Math.random() * 6 - 3) + 'deg)';
          span.style.opacity = String(0.35 + Math.random() * 0.35);
          heroField.appendChild(span);
        }

        // Readout wiring
        const roLabel = document.getElementById('ro-label');
        const setLabel = (label) => (self) => {
          if (self.isActive) roLabel.textContent = label;
        };
        const pinCfg = (trigger, end, label) => ({
          trigger,
          start: 'top top',
          end,
          pin: true,
          scrub: true,
          onToggle: setLabel(label),
        });
        const LABELS = [
          'STEP 01 / 05 — TELL US',
          'STEP 02 / 05 — DRAFT ONE',
          'STEP 03 / 05 — REVISE',
          'STEP 04 / 05 — LIVE',
          'STEP 05 / 05 — YOURS',
        ];

        // ================= PINNED SCENES (creation order = refresh order) =================

        // S1 — intake chips drift up and past
        gsap
          .timeline({ scrollTrigger: pinCfg('#s1', '+=160%', LABELS[0]) })
          .from('.chip', {
            y: 120,
            autoAlpha: 0,
            stagger: 0.06,
            ease: 'power2.out',
            duration: 0.5,
          }, 0)
          .to('.chip', {
            y: -160,
            autoAlpha: 0,
            stagger: 0.05,
            ease: 'power2.in',
            duration: 0.5,
          }, 1.0)
          .to('#s1 .scene-copy', { y: -90, autoAlpha: 0, ease: 'power1.in', duration: 0.5 }, 1.15);

        // S2 — the wireframe draws itself, then fills
        const wfLines = gsap.utils.toArray('.wf-line');
        wfLines.forEach((el) => {
          const len = el.getTotalLength();
          el.style.strokeDasharray = len;
          el.style.strokeDashoffset = len;
        });
        gsap
          .timeline({ scrollTrigger: pinCfg('#s2', '+=180%', LABELS[1]) })
          .to(wfLines, {
            strokeDashoffset: 0,
            ease: 'none',
            stagger: 0.08,
            duration: 0.9,
          }, 0.05)
          .to('.wf-cta', { fill: 'rgba(255,81,71,0.85)', duration: 0.2 }, 1.1)
          .fromTo('#s2-tag', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.2 }, 1.25);

        // S3 — edits get struck and replaced
        const editTl = gsap.timeline({
          scrollTrigger: pinCfg('#s3', '+=190%', LABELS[2]),
        });
        editTl.from('.edit', { y: 60, autoAlpha: 0, stagger: 0.12, duration: 0.35 }, 0);
        gsap.utils.toArray('.edit').forEach((row, i) => {
          editTl
            .to(row.querySelector('.strike'), { scaleX: 1, duration: 0.14 }, 0.7 + i * 0.28)
            .fromTo(
              row.querySelector('.edit-new'),
              { autoAlpha: 0, x: 24 },
              { autoAlpha: 1, x: 0, duration: 0.18 },
              0.82 + i * 0.28
            );
        });
        editTl.fromTo('#s3-sub', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.25 }, 1.75);

        // S4 — the line goes live: steady pulses draw across
        const sigPaths = gsap.utils.toArray('.sigpath');
        const sigLen = sigPaths[0].getTotalLength();
        sigPaths.forEach((p) => {
          p.style.strokeDasharray = sigLen;
          p.style.strokeDashoffset = sigLen;
        });
        gsap
          .timeline({ scrollTrigger: pinCfg('#s4', '+=200%', LABELS[3]) })
          .fromTo('#s4-h', { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.25 }, 0.02)
          .to(sigPaths, { strokeDashoffset: 0, ease: 'none', duration: 1.2 }, 0.1)
          .fromTo('#s4-sub', { autoAlpha: 0, y: 26 }, { autoAlpha: 1, y: 0, duration: 0.25 }, 0.6)
          .fromTo('#s4-tag', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.15 }, 1.35);

        // S5 — paper floods, ownership lands
        gsap
          .timeline({ scrollTrigger: pinCfg('#s5', '+=180%', LABELS[4]) })
          .to('.paper-flood', { clipPath: 'circle(142% at 50% 55%)', ease: 'power2.inOut', duration: 0.7 }, 0)
          .fromTo('.brand-square', { scale: 0, rotation: 45 }, { scale: 1, rotation: 0, ease: 'back.out(1.6)', duration: 0.18 }, 0.72)
          .from('.wm-char', { yPercent: 120, stagger: 0.03, ease: 'power4.out', duration: 0.25 }, 0.8)
          .fromTo('.film-eyebrow--ink', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.15 }, 0.85)
          .fromTo('.ch5-tag', { autoAlpha: 0, y: 30 }, { autoAlpha: 1, y: 0, duration: 0.25 }, 1.1)
          .fromTo('.ch5-line', { autoAlpha: 0, y: 26 }, { autoAlpha: 1, y: 0, duration: 0.25 }, 1.25)
          .fromTo('.ch5-ctas', { autoAlpha: 0, y: 26 }, { autoAlpha: 1, y: 0, duration: 0.3 }, 1.4)
          .to({}, { duration: 0.4 });

        // ================= AMBIENT (after all pins — the ordering law) =================

        // Hero field parallax out
        gsap.to('.hero-field', {
          autoAlpha: 0,
          scale: 1.15,
          ease: 'none',
          scrollTrigger: {
            trigger: '.hero',
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });

        // Chrome flip once paper floods in S5
        const chrome = [document.getElementById('film-header'), document.getElementById('readout')];
        ScrollTrigger.create({
          trigger: '#s5',
          start: 'top top',
          end: '+=180%',
          onUpdate: (self) => {
            const light = self.progress > 0.3;
            chrome.forEach((el) => el && el.classList.toggle('on-light', light));
          },
          onLeaveBack: () => chrome.forEach((el) => el && el.classList.remove('on-light')),
        });

        // Film progress bar + readout visibility (hidden until the film begins)
        const roFill = document.getElementById('ro-fill');
        const readout = document.getElementById('readout');
        readout.style.opacity = '0';
        ScrollTrigger.create({
          trigger: '#filmwrap',
          start: 'top 60%',
          end: 'bottom bottom',
          onUpdate: (self) => {
            roFill.style.width = (self.progress * 100).toFixed(1) + '%';
            const inFilm = self.progress > 0.001 && self.progress < 0.985;
            readout.style.opacity = inFilm ? '1' : '0';
            const skip = document.getElementById('skip-film');
            if (skip) {
              skip.style.opacity = self.progress < 0.985 ? '' : '0';
              skip.style.pointerEvents = self.progress < 0.985 ? '' : 'none';
            }
          },
        });

        // Jank meter — dev/verification only, never in visitors' consoles
        if (JUMP !== null || location.search.includes('debug')) {
          let last = performance.now();
          let max = 0;
          const tick = () => {
            const now = performance.now();
            max = Math.max(max, now - last);
            last = now;
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          setInterval(() => {
            if (max > 0) console.log('[jank] max frame ' + max.toFixed(1) + 'ms');
            max = 0;
          }, 2000);
        }

        // ---- Dev contract: settle & signal readiness ----
        // Hash jumps from other pages land before the pinned scenes inflate
        // the page. GSAP re-refreshes on window load, so the correction must
        // run after that storm settles — hence the delay.
        const correctHash = () => {
          try {
            const target = document.querySelector(location.hash);
            if (target) {
              const y = target.getBoundingClientRect().top + scrollY;
              if (lenis) lenis.scrollTo(y, { immediate: true });
              else scrollTo(0, y);
              ScrollTrigger.update();
            }
          } catch (e) {}
        };
        const ready = () =>
          requestAnimationFrame(() => {
            window.__ready = true;
          });
        const settle = () => {
          ScrollTrigger.refresh();
          if (JUMP !== null) {
            scrollTo(0, +JUMP || 0);
            ScrollTrigger.update();
            ready();
          } else if (location.hash) {
            // Twice: once after GSAP's load refresh, once after the
            // browser's own late re-anchor (which fires near pin borders).
            setTimeout(correctHash, 300);
            setTimeout(() => {
              correctHash();
              ready();
            }, 900);
          } else {
            ready();
          }
        };
        if (document.readyState === 'complete') {
          document.fonts.ready.then(settle);
        } else {
          addEventListener('load', () => document.fonts.ready.then(settle));
        }
      })();
    </script>

    <style is:global>
      @font-face {
        font-family: 'Space Grotesk';
        src: url('/fonts/space-grotesk-700.woff2') format('woff2');
        font-weight: 700;
        font-display: swap;
      }
      @font-face {
        font-family: 'Space Grotesk';
        src: url('/fonts/space-grotesk-500.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }

      :root {
        --film-bg: #0b111c;
        --film-dim: #3d4a63;
        --film-mid: #5c6b85;
        --signal-bright: #ff5147;
        --blue-bright: #6e9bff;
        --font-display: 'Space Grotesk', var(--font-sans);
      }

      html.film-off #filmwrap,
      html.film-off .chapter-readout {
        display: none;
      }
      html.film-off .static-steps {
        display: block;
      }

      .static-steps {
        display: none;
      }

      .anchor-offset {
        position: relative;
        top: -1px;
      }

      /* ---- Fixed chrome ---- */
      .film-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 60;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem clamp(1.25rem, 4vw, 2.5rem);
        --chrome: var(--footer-paper);
      }
      .film-header.on-light {
        --chrome: var(--ink);
        background: color-mix(in srgb, var(--paper) 90%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }
      .fh-wordmark {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 750;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
        color: var(--chrome);
        text-decoration: none;
        transition: color 200ms ease;
      }
      .fh-mark {
        width: 0.7rem;
        height: 0.7rem;
        background: var(--signal-bright);
        border-radius: 2px;
      }
      .fh-nav {
        display: flex;
        align-items: center;
        gap: var(--space-4);
      }
      .fh-link {
        font-weight: 550;
        font-size: var(--text-sm);
        color: var(--chrome);
        opacity: 0.85;
        text-decoration: none;
        transition: color 200ms ease;
      }
      .fh-link:hover {
        opacity: 1;
        color: var(--signal-bright);
      }
      .fh-skip {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--chrome);
        opacity: 0.7;
        text-decoration: none;
        transition: opacity 300ms ease, color 200ms ease;
      }
      .fh-skip:hover {
        opacity: 1;
        color: var(--signal-bright);
      }
      .film-header.on-light .fh-link:hover {
        color: var(--signal-strong);
      }
      .fh-cta {
        font-weight: 600;
        font-size: var(--text-sm);
        color: var(--chrome);
        border: 1.5px solid currentColor;
        border-radius: var(--radius);
        padding: 0.6em 1.1em;
        text-decoration: none;
        transition: color 200ms ease, background-color 150ms ease;
      }
      .fh-cta:hover {
        background: var(--signal-strong);
        border-color: var(--signal-strong);
        color: #fff;
      }

      /* ---- Hero ---- */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--film-bg);
      }
      .hero-copy {
        position: relative;
        z-index: 3;
        text-align: center;
        padding-inline: clamp(1.25rem, 4vw, 2.5rem);
        max-width: 62rem;
      }
      .hero-field {
        position: absolute;
        inset: 0;
        will-change: transform, opacity;
      }
      .hero-ctas {
        justify-content: center;
        margin-top: var(--space-5);
      }
      .hero-ghost {
        border-color: var(--film-mid);
        color: var(--footer-paper);
      }
      .hero-ghost:hover {
        border-color: var(--footer-paper);
        color: var(--footer-paper);
      }
      .hero-welcome {
        margin: var(--space-4) auto 0;
        font-size: var(--text-sm);
        color: var(--film-mid);
        max-width: 52ch;
      }

      /* ---- Scenes ---- */
      .scene {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .scene--dark {
        background: var(--film-bg);
      }
      .scene-copy {
        position: relative;
        z-index: 3;
        text-align: center;
        padding-inline: clamp(1.25rem, 4vw, 2.5rem);
        max-width: 62rem;
      }
      .film-eyebrow {
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--blue-bright);
        margin-bottom: var(--space-4);
      }
      .film-eyebrow--ink {
        color: var(--blue);
      }
      .film-h {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.3rem, 1.5rem + 4.6vw, 4.8rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        color: var(--footer-paper);
        text-wrap: balance;
      }
      .film-h--small {
        font-size: clamp(1.7rem, 1.2rem + 3vw, 3.2rem);
      }
      .film-sub {
        margin: var(--space-4) auto 0;
        font-size: var(--text-lg);
        color: var(--film-mid);
        max-width: 44ch;
      }
      .mono-tag {
        margin-top: var(--space-5);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.25em;
        color: var(--blue-bright);
      }
      .scroll-hint {
        margin-top: var(--space-6);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--film-dim);
        animation: hint-pulse 2.2s ease-in-out infinite;
      }
      @keyframes hint-pulse {
        0%, 100% { opacity: 0.35; transform: translateY(0); }
        50% { opacity: 1; transform: translateY(6px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-hint { animation: none; }
      }

      /* Ambient word field (hero) */
      .nw {
        position: absolute;
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--film-dim);
        white-space: nowrap;
        user-select: none;
      }
      .nw--stroke {
        color: transparent;
        -webkit-text-stroke: 1px var(--film-dim);
      }

      /* S1 chips */
      .chip-field {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        place-items: center;
        padding: 12vh 6vw;
        pointer-events: none;
      }
      .chip {
        font-family: var(--font-mono);
        font-size: clamp(0.7rem, 0.6rem + 0.5vw, 0.95rem);
        letter-spacing: 0.08em;
        color: var(--film-mid);
        border: 1px solid var(--film-dim);
        border-radius: 999px;
        padding: 0.5em 1.1em;
        white-space: nowrap;
      }
      .chip:nth-child(even) {
        color: var(--blue-bright);
        border-color: color-mix(in srgb, var(--blue-bright) 45%, transparent);
      }

      /* S2 wireframe */
      .wireframe {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -58%);
        width: min(560px, 82vw);
        z-index: 1;
        opacity: 0.9;
      }
      .wf-line {
        fill: none;
        stroke: var(--film-mid);
        stroke-width: 1.5;
      }
      .wf-cta {
        stroke: var(--signal-bright);
      }
      #s2 .scene-copy {
        margin-top: 46vh;
      }
      #s2 .mono-tag {
        margin-top: var(--space-3);
      }

      /* S3 edits */
      .edits {
        margin-top: var(--space-5);
        display: grid;
        gap: var(--space-4);
      }
      .edit {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6em 1.2em;
        justify-content: center;
        align-items: baseline;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: clamp(1.1rem, 0.9rem + 1.6vw, 1.9rem);
      }
      .edit-old {
        position: relative;
        color: var(--film-mid);
      }
      .edit-old .strike {
        position: absolute;
        left: -2%;
        right: -2%;
        top: 52%;
        height: 0.08em;
        min-height: 2.5px;
        background: var(--signal-bright);
        transform: scaleX(0);
        transform-origin: left center;
        border-radius: 2px;
      }
      .edit-new {
        color: var(--footer-paper);
        visibility: hidden;
      }
      #s3-sub {
        visibility: hidden;
      }

      /* S4 wave */
      .sigwave {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }
      .sigpath {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .sigpath--core {
        stroke: var(--blue-bright);
        stroke-width: 2.5;
      }
      .sigpath--glow {
        stroke: var(--blue-bright);
        stroke-width: 9;
        opacity: 0.18;
      }
      .sigpath--halo {
        stroke: var(--blue-bright);
        stroke-width: 22;
        opacity: 0.07;
      }
      #s4 .scene-copy {
        position: static;
      }
      #s4 .film-eyebrow {
        position: absolute;
        top: 12%;
        left: 50%;
        transform: translateX(-50%);
      }
      #s4-h {
        position: absolute;
        top: 18%;
        left: 50%;
        transform: translateX(-50%);
        width: max-content;
        max-width: 90vw;
        visibility: hidden;
      }
      #s4-sub {
        position: absolute;
        bottom: 26%;
        left: 50%;
        transform: translateX(-50%);
        visibility: hidden;
      }
      #s4-tag {
        position: absolute;
        bottom: 18%;
        left: 50%;
        transform: translateX(-50%);
        visibility: hidden;
        margin: 0;
      }

      /* S5 ownership */
      .paper-flood {
        position: absolute;
        inset: 0;
        background: var(--paper);
        clip-path: circle(0% at 50% 55%);
        z-index: 1;
      }
      .ch5-copy {
        z-index: 2;
      }
      .wm {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(0.6rem, 2vw, 1.4rem);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(3rem, 1.6rem + 8vw, 7rem);
        letter-spacing: -0.03em;
        color: var(--ink);
        line-height: 1;
      }
      .brand-square {
        width: 0.55em;
        height: 0.55em;
        background: var(--signal-strong);
        border-radius: 0.08em;
        flex-shrink: 0;
        will-change: transform;
      }
      .wm-chars {
        display: inline-flex;
        overflow: hidden;
        padding-bottom: 0.08em;
      }
      .wm-char {
        display: inline-block;
        will-change: transform;
      }
      .ch5-tag {
        margin: var(--space-4) auto 0;
        font-size: var(--text-lg);
        color: var(--ink);
        font-weight: 600;
        max-width: 46ch;
      }
      .ch5-line {
        margin: var(--space-3) auto 0;
        color: var(--ink-soft);
        max-width: 52ch;
      }
      .ch5-ctas {
        justify-content: center;
        margin-top: var(--space-5);
      }

      /* ---- Chapter readout ---- */
      .chapter-readout {
        position: fixed;
        left: clamp(1.25rem, 4vw, 2.5rem);
        bottom: 1.4rem;
        z-index: 55;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        --chrome: var(--footer-paper);
        transition: opacity 400ms ease;
        pointer-events: none;
      }
      .chapter-readout.on-light {
        --chrome: var(--ink);
      }
      .ro-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        color: var(--chrome);
        transition: color 200ms ease;
      }
      .ro-bar {
        width: clamp(4rem, 10vw, 8rem);
        height: 2px;
        background: color-mix(in srgb, currentColor 25%, transparent);
        color: var(--chrome);
        border-radius: 2px;
        overflow: hidden;
        display: inline-block;
      }
      .ro-fill {
        display: block;
        height: 100%;
        width: 0%;
        background: var(--signal-bright);
      }

      /* ---- Intake wizard ---- */
      .wiz-chooser {
        display: none; /* no-JS: chooser hidden, full forms shown instead */
        gap: var(--space-4);
        grid-template-columns: 1fr;
      }
      @media (min-width: 44rem) {
        .wiz-chooser {
          grid-template-columns: 1fr 1fr;
        }
      }
      html.js .wiz-chooser {
        display: grid;
      }
      html.js .wiz-chooser.is-hidden {
        display: none;
      }
      .wiz-choice {
        text-align: left;
        cursor: pointer;
        font: inherit;
        transition: border-color 120ms ease, transform 120ms ease;
      }
      .wiz-choice:hover {
        border-color: var(--blue);
        transform: translateY(-2px);
      }
      .wiz-choice h3 {
        margin-bottom: var(--space-2);
      }
      .wiz-choice__meta {
        display: block;
        margin-top: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--blue);
      }

      .intake-stack {
        display: grid;
        gap: var(--space-5);
        max-width: 40rem;
      }
      /* JS on: forms hidden until chosen; steps advance one at a time. */
      html.js .wiz-form {
        display: none;
      }
      html.js .wiz-form.is-active {
        display: block;
      }
      html.js .wiz-step {
        display: none;
      }
      html.js .wiz-step.is-current {
        display: block;
      }
      .wiz-head {
        display: none;
        align-items: center;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
      }
      html.js .wiz-head {
        display: flex;
      }
      .wiz-back {
        background: none;
        border: 1.5px solid var(--line-strong);
        border-radius: var(--radius);
        width: 2.2rem;
        height: 2.2rem;
        font-size: 1rem;
        color: var(--ink);
        cursor: pointer;
      }
      .wiz-back:hover {
        border-color: var(--blue);
        color: var(--blue);
      }
      .wiz-count {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        color: var(--ink-faint);
        min-width: 4.5em;
      }
      .wiz-track {
        flex: 1;
        height: 3px;
        background: var(--line);
        border-radius: 2px;
        overflow: hidden;
      }
      .wiz-fill {
        display: block;
        height: 100%;
        width: 0%;
        background: var(--blue);
        transition: width 200ms ease;
      }
      .wiz-foot {
        margin-top: var(--space-3);
      }
      .wiz-final-note {
        font-weight: 600;
        margin-bottom: var(--space-3);
      }
      html.js .wiz-title {
        font-size: var(--text-lg);
      }
      .intake-form h3 {
        margin-bottom: var(--space-2);
      }
      .intake-blurb {
        margin-bottom: var(--space-4);
        font-size: var(--text-sm);
      }
      .hp-field {
        position: absolute !important;
        left: -9999px !important;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      [aria-invalid] {
        border-color: #b3261e !important;
      }
      .form-error {
        color: #b3261e;
        font-size: var(--text-sm);
        font-weight: 600;
        margin-bottom: var(--space-3);
      }
      .form-success {
        color: var(--ink);
        font-weight: 600;
        background: var(--signal-tint);
        border-radius: var(--radius);
        padding: var(--space-3);
      }
      .intake-submit[disabled] {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .intake-fallback {
        margin-top: var(--space-3);
        font-size: var(--text-sm);
      }
      .checklist--neutral li::before {
        border-color: var(--line-strong);
      }

      @media (max-width: 47.99rem) {
        .fh-link {
          display: none;
        }
        .chip-field {
          grid-template-columns: repeat(2, 1fr);
          padding: 14vh 4vw;
        }
        .ro-label {
          font-size: 0.6rem;
        }
      }
    </style>
  </body>
</html>
