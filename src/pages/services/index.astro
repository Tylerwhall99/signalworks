---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ADD_ONS, CARE_PLANS, SERVICE_LADDER } from '../../config';
---

<Base
  title="Services"
  description="The website is free. These are the month-to-month services that make it ring — lead capture, reviews, and site care. Every one cancels anytime."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>The website is free. This is how we get paid.</h1>
      <p class="lede" style="margin-top: var(--space-4);">
        The website is free. These are the services that make it ring — and
        they're how we get paid. Every one is month-to-month, cancel
        anytime, everything handed over within 5 business days if you
        leave.
      </p>
    </div>
  </section>

  <section class="section" id="ladder">
    <div class="container">
      <div class="ladder">
        {
          SERVICE_LADDER.map((svc, i) => (
            <div class="card rung">
              <span class="rung-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="rung-hook">“{svc.hook}”</p>
              <h2 class="rung-name">{svc.name}</h2>
              <p class="rung-price">
                {svc.price}
                <span class="cancel-note">cancel anytime</span>
              </p>
              {svc.bundleNote && <p class="rung-bundle">{svc.bundleNote}</p>}
              <p class="muted">{svc.blurb}</p>
            </div>
          ))
        }

        <div class="card rung" id="plans">
          <span class="rung-num" aria-hidden="true">
            {String(SERVICE_LADDER.length + 1).padStart(2, '0')}
          </span>
          <p class="rung-hook">“Site handled”</p>
          <h2 class="rung-name">
            {CARE_PLANS.map((p) => p.name).join(' · ')}
          </h2>
          <p class="rung-price">
            {CARE_PLANS.map((p) => p.price).join(' · ')}
            <span class="cancel-note">cancel anytime</span>
          </p>
          <p class="muted">
            {CARE_PLANS[0].name}: we run hosting, uptime, and security
            updates. {CARE_PLANS[1].name}: all of that plus 3 monthly
            content edits and a monthly report. Or run it yourself for
            ~$0–20/mo — we'll set that up free either way.
          </p>
          <p class="muted" style="font-size: var(--text-sm); margin-top: var(--space-3);">
            An "edit" is one request email covering up to three small
            changes to existing pages. Unused edits don't roll over.
            <a href="/terms/">Full terms</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Beyond the ladder</span>
        <h2>Custom builds &amp; stores — quoted per project.</h2>
        <p class="muted">
          Online stores with checkout, booking flows, quote builders,
          portals, internal tools — scoped in writing with a fixed number
          before any money changes hands, and you own the code from day
          one. If we set up online payments for you, they run through your
          own Stripe account and our platform share of each transaction is
          disclosed in writing before anything goes live.
        </p>
        <p style="margin-top: var(--space-3);">
          <a href="/contact/">Ask about a custom build →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Add-ons</span>
        <h2>One-off work, priced before it starts.</h2>
      </div>
      <table>
        <thead>
          <tr><th>Add-on</th><th>Price</th></tr>
        </thead>
        <tbody>
          {
            ADD_ONS.map((a) => (
              <tr>
                <td>{a.name}</td>
                <td>{a.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .ladder {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
  }

  .rung {
    position: relative;
    padding-left: calc(var(--space-4) + 3.2rem);
  }

  .rung-num {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--signal);
  }

  .rung-hook {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: var(--space-1);
  }

  .rung-name {
    font-size: var(--text-xl);
  }

  .rung-price {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--blue);
    margin: var(--space-2) 0;
  }

  .cancel-note {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-left: 0.7em;
  }

  .rung-bundle {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  @media (max-width: 40rem) {
    .rung {
      padding-left: var(--space-4);
    }
    .rung-num {
      position: static;
      display: block;
      margin-bottom: var(--space-1);
    }
  }
</style>
