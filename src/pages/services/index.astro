---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import {
  ADD_ONS,
  CARE_PLANS,
  CLEARED_SERVICES,
  CUSTOM_RETAINER,
  LIVE_SERVICES,
  serviceHref,
} from '../../config';
---

<Base
  title="Services"
  description="A free website build for home services businesses, ongoing growth services quoted plainly, and custom web apps scoped per project."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>The free site, and what comes after.</h1>
      <p class="lede" style="margin-top: var(--space-4);">
        The build is free and it's yours. Everything beyond it is optional,
        quoted plainly, and never a surprise on an invoice.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        <div class="card">
          <h2 class="svc-h">Free website</h2>
          <p class="muted">
            The pages your business needs, copy written from your intake,
            mobile-first, click-to-call, live on your own domain. One
            revision round included, and bug fixes are free for 60 days
            after launch. You own all of it.
          </p>
          <p style="margin-top: var(--space-3);">
            <a href="/#included">Full scope →</a><br />
            <a href="/#start">Start my free site →</a>
          </p>
        </div>

        <div class="card">
          <h2 class="svc-h">Ongoing services</h2>
          {
            CLEARED_SERVICES.length > 0 ? (
              <>
                <p class="muted">
                  The month-after-month work, quoted plainly before anything
                  starts:
                </p>
                <ul class="checklist">
                  {CLEARED_SERVICES.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </>
            ) : (
              <p class="muted">
                Ongoing growth services — the work that takes sustained
                effort month after month. Ask us what fits your business;
                you'll get a plain written quote, never a pitch deck.
              </p>
            )
          }
          <p class="muted" style="margin-top: var(--space-3);">
            <a href="#plans">Care plans</a> run from {CARE_PLANS[0].price} —
            hosting, updates, and support in fixed quantities, cancel
            anytime.
          </p>
          {
            LIVE_SERVICES.length > 0 && (
              <ul class="checklist" style="margin-top: var(--space-3);">
                {LIVE_SERVICES.map((s) => (
                  <li>
                    <a href={serviceHref(s)}>{s.navLabel ?? s.name}</a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="card">
          <h2 class="svc-h">Custom builds &amp; web apps</h2>
          <p class="muted">
            Booking flows, quote builders, client portals, internal tools —
            custom software scoped in writing and quoted per project. A
            written spec and a fixed number before any money changes hands,
            and you own the code from day one.
          </p>
          <p style="margin-top: var(--space-3);">
            <a href="/contact/">Ask about a custom build →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--rule" id="plans">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Care plans</span>
        <h2>After launch: three plans, plain quantities.</h2>
        <p class="muted">
          Every plan is optional and cancels anytime — if you leave, the
          full handoff into your accounts happens within 5 business days at
          no charge. You own everything throughout.
        </p>
      </div>
      <div class="grid grid--3">
        {
          CARE_PLANS.map((plan) => (
            <div class="card plan-card">
              <h3>{plan.name}</h3>
              <p class="plan-price">{plan.price}</p>
              <p class="muted plan-blurb">{plan.blurb}</p>
              <ul class="checklist">
                {plan.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="muted" style="margin-top: var(--space-4);">
        <strong>{CUSTOM_RETAINER.name}</strong> — {CUSTOM_RETAINER.price}.
        {CUSTOM_RETAINER.blurb}
      </p>
      <p class="muted" style="margin-top: var(--space-3); font-size: var(--text-sm);">
        An "edit" is one request email covering up to three small changes
        to existing pages. Unused edits don't roll over — plans are
        quantities, not fine print. <a href="/terms/">Full terms</a>.
      </p>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Add-ons</span>
        <h2>One-off work, priced before it starts.</h2>
        <p class="muted">
          Attach to any plan, or buy on their own — every one quoted in
          writing before work begins.
        </p>
      </div>
      <table>
        <thead>
          <tr><th>Add-on</th><th>Price</th></tr>
        </thead>
        <tbody>
          {
            ADD_ONS.map((a) => (
              <tr>
                <td>{a.name}</td>
                <td>{a.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="muted" style="margin-top: var(--space-4); font-size: var(--text-sm);">
        Getting paid online — invoice payments and deposits through your
        own Stripe account — can be added to any plan. Ask us; fees are
        disclosed in writing before anything goes live.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .svc-h {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .plan-card h3 {
    font-size: var(--text-xl);
  }

  .plan-price {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--blue);
    margin: var(--space-2) 0;
  }

  .plan-blurb {
    margin-bottom: var(--space-3);
  }

  .plan-card .checklist li {
    font-size: var(--text-sm);
  }
</style>
