---
import Base from '../layouts/Base.astro';
import { CONTACT, CONTACT_READY, PHONE_HREF } from '../config';

const hasForm = CONTACT.formEndpoint.length > 0 && CONTACT.accessKey.length > 0;
const hasDirect = CONTACT_READY.email || CONTACT_READY.phone;
// The lede used to instruct the visitor to email while the block directly
// below said email did not exist yet. Gate the instruction, keep the promise.
const ledeTail = CONTACT_READY.email
  ? "For anything else, a few plain sentences by email works. You'll hear back within one business day."
  : "You'll hear back within one business day.";
---

<Base
  title="Contact"
  description="Tell The Free Website Co. about your business. Straight answer on scope, price, and timeline — usually within one business day."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Reach a person, directly.</h1>
      <p class="lede" style="margin-top: var(--space-4);">
        Starting a free site? The <a href="/#start">intake form</a> is the
        fastest path — no call needed. {ledeTail}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2 class="contact-h">Direct</h2>
        {
          hasDirect ? (
            <ul class="contact-list">
              {CONTACT_READY.email && (
                <li>
                  <span class="eyebrow" style="margin-bottom: var(--space-1);">Email</span>
                  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
                </li>
              )}
              {CONTACT_READY.phone && (
                <li>
                  <span class="eyebrow" style="margin-bottom: var(--space-1);">Phone</span>
                  <a href={`tel:${PHONE_HREF}`}>{CONTACT.phone}</a>
                </li>
              )}
            </ul>
          ) : (
            <p class="muted">
              Direct email and phone are being set up on the new domain and
              will appear here within days. The <a href="/#start">intake form</a>
              is the way in meanwhile.
            </p>
          )
        }
        <div class="contact-next">
          <h2 class="contact-h">{hasDirect || hasForm ? 'What happens after you write' : 'What happens once you send intake'}</h2>
          <ol class="steps">
            <li>
              <h3>You get a reply</h3>
              <p class="muted">
                Within one business day, from me — a real answer, not an
                autoresponder.
              </p>
            </li>
            <li>
              <h3>We confirm your draft timeline</h3>
              <p class="muted">
                For free builds: intake in, draft timeline confirmed, no
                sales call. For custom work: a written scope and a fixed
                quote.
              </p>
            </li>
            <li>
              <h3>You see something real</h3>
              <p class="muted">
                A working draft on a live preview link — not a mockup, not a
                pitch deck. Then it's your call, with no follow-up pressure
                campaign.
              </p>
            </li>
          </ol>
        </div>
      </div>

      {
        hasForm && (
          <form
            method="POST"
            action={CONTACT.formEndpoint}
            class="contact-form"
          >
            <h2 class="contact-h">Or use the form</h2>
            <input type="hidden" name="access_key" value={CONTACT.accessKey} />
            <input
              type="hidden"
              name="subject"
              value="Contact form — freewebsiteco.com"
            />
            <input type="hidden" name="from_name" value="The Free Website Co. contact" />
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="business">What does your business do?</label>
              <input
                id="business"
                name="business"
                type="text"
                placeholder="e.g. Residential electrician in Sacramento"
              />
            </div>
            <div class="field">
              <label for="message">What's not working?</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="A few plain sentences is perfect."
              />
            </div>
            <button type="submit" class="btn btn--primary btn--large">
              Send it
            </button>
          </form>
        )
      }
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-h {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li + li {
    margin-top: var(--space-4);
  }

  .contact-list a {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .contact-next {
    margin-top: var(--space-6);
  }
</style>
