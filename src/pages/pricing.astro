---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { PRICING, CARE_PLAN } from '../config';
---

<Base
  title="Pricing"
  description="Flat, fixed prices for custom websites and web apps. The number in your quote is the number on your invoice."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h1>Flat prices, in writing, before work starts.</h1>
      <p class="lede" style="margin-top: var(--space-4);">
        No hourly meters, no surprise invoices, no "it depends" until you've
        signed. The number in your quote is the number on your invoice.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {
          PRICING.map((pkg) => (
            <div class="card price-card">
              <h2>{pkg.name}</h2>
              <p class="price-card__price">
                {pkg.price}
                <span class="price-card__note">{pkg.priceNote}</span>
              </p>
              <p class="price-card__timeline">{pkg.timeline}</p>
              <p class="muted">{pkg.summary}</p>
              <ul class="checklist">
                {pkg.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a href={pkg.ctaHref} class="btn btn--primary price-card__cta">
                {pkg.ctaLabel}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">After launch</span>
        <h2>{CARE_PLAN.name} — {CARE_PLAN.price}</h2>
        <p class="muted">{CARE_PLAN.priceNote}. {CARE_PLAN.summary}</p>
      </div>
      <ul class="checklist">
        {CARE_PLAN.includes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">How paying works</span>
        <h2>Half to start, half at launch.</h2>
        <p class="muted">
          Fifty percent books your slot and starts the work. The rest is due
          when the site goes live — after you've seen it, clicked through it,
          and signed off on it. Web apps over a few weeks split into monthly
          milestones instead.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Questions about price</span>
        <h2>The ones people actually ask.</h2>
      </div>
      <details class="faq">
        <summary>Why is this cheaper than an agency?</summary>
        <div class="faq-body">
          <p>
            Because you're not paying for an office, a sales team, and four
            people in every meeting. I'm one builder using AI-accelerated
            tooling to do work that used to take a team. Same output standard,
            a fraction of the overhead. That's the honest math.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>Why is this more expensive than a website builder?</summary>
        <div class="faq-body">
          <p>
            A do-it-yourself builder costs less until you count your own
            weekends. You're paying for the site to be designed, written,
            built, and launched for you — and for it to be custom, not a
            template with your logo on it.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>What's not included?</summary>
        <div class="faq-body">
          <p>
            Your domain name (usually $10–20/year, registered in your name),
            photography — real photos of your trucks, crews, and finished
            jobs beat stock every time — and any paid advertising. If hosting
            your site costs money — most of these builds host free — that
            bill goes to you directly, in your account. I don't mark up other
            people's services.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>Can the price change mid-project?</summary>
        <div class="faq-body">
          <p>
            Not for anything inside the written scope. If you ask for
            something new mid-build, you get a written price for the addition
            before I touch it, and you can always say no.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>Do you promise results?</summary>
        <div class="faq-body">
          <p>
            I promise deliverables, timelines, and conduct: what you get,
            when you get it, and how you'll be treated. I don't promise
            rankings, traffic, or revenue — those depend on your market, your
            reputation, and forces nobody sells honestly. Anyone who
            guarantees them is guessing with your money.
          </p>
        </div>
      </details>
    </div>
  </section>

  <CtaBand
    heading="Want a number for your project?"
    body="Tell me what you need. You'll get a fixed quote and a delivery date in writing — and if a cheaper option would serve you fine, I'll say so."
  />
</Base>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .price-card h2 {
    font-size: var(--text-xl);
  }

  .price-card__price {
    font-size: var(--text-2xl);
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .price-card__note {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: var(--space-2);
  }

  .price-card__timeline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--signal);
    letter-spacing: 0.04em;
  }

  .price-card .checklist {
    flex-grow: 1;
  }

  .price-card .checklist li {
    font-size: var(--text-sm);
  }

  .price-card__cta {
    text-align: center;
    margin-top: var(--space-2);
  }
</style>
