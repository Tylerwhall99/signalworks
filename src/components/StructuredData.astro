---
/**
 * JSON-LD for the home page. Everything derives from src/config.ts, so
 * updating the offer or contact details there keeps structured data in sync.
 */
import { BRAND, CARE_PLAN, CONTACT, SITE_URL } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: BRAND.name,
  description: BRAND.description,
  url: SITE_URL,
  email: CONTACT.email,
  telephone: CONTACT.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.address,
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Website services',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Free website build',
        description:
          'A free, professional website for home services businesses — the pages the business needs, owned outright by the client, with one revision round and 60 days of free bug fixes.',
        price: '0',
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: CARE_PLAN.name,
        description: CARE_PLAN.summary,
        price: CARE_PLAN.price.replace(/[^0-9.]/g, ''),
        priceCurrency: 'USD',
      },
    ],
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
  is:inline
/>
