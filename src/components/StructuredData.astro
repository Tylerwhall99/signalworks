---
/**
 * JSON-LD for the home page. Everything derives from src/config.ts, so
 * updating the offer or contact details there keeps structured data in sync.
 */
import { BRAND, CARE_PLANS, CONTACT, CONTACT_READY, SITE_URL } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: BRAND.name,
  description: BRAND.description,
  url: SITE_URL,
  image: new URL('/og.png', SITE_URL).href,
  // Contact fields appear only once they are real (see CONTACT_READY).
  ...(CONTACT_READY.email ? { email: CONTACT.email } : {}),
  ...(CONTACT_READY.phone ? { telephone: CONTACT.phone } : {}),
  address: {
    '@type': 'PostalAddress',
    ...(CONTACT_READY.address ? { streetAddress: CONTACT.address } : {}),
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Website services',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Free website build',
        description:
          'A free, professional website for home services businesses — the pages the business needs, owned outright by the client, with one revision round and 60 days of free bug fixes.',
        price: '0',
        priceCurrency: 'USD',
      },
      // These are monthly subscriptions; a bare price reads as one-time.
      ...CARE_PLANS.map((plan) => ({
        '@type': 'Offer',
        name: plan.name,
        description: plan.blurb,
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: plan.price.replace(/[^0-9.]/g, ''),
          priceCurrency: 'USD',
          unitCode: 'MON',
          billingIncrement: 1,
        },
      })),
    ],
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
  is:inline
/>
