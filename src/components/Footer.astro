---
import { BRAND, CARE_PLAN, CONTACT, NAV } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__wordmark">{BRAND.name}</p>
        <p class="site-footer__tagline">{BRAND.tagline}</p>
        <p class="site-footer__meta">
          Based in Los Angeles. Home services is the specialty — every
          business is welcome, nationwide.
        </p>
      </div>

      <nav aria-label="Footer — pages">
        <p class="site-footer__heading">Pages</p>
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/terms/">Free-build terms</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>

      <nav aria-label="Footer — the offer">
        <p class="site-footer__heading">The offer</p>
        <ul>
          <li><a href="/#start">Start a free site</a></li>
          <li><a href="/#included">What's included</a></li>
          <li><a href="/services/">{CARE_PLAN.name} &amp; services</a></li>
        </ul>
      </nav>

      <div>
        <p class="site-footer__heading">Contact</p>
        <ul>
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a href={`tel:${CONTACT.phone}`}>{CONTACT.phone}</a></li>
          <li class="site-footer__address">{CONTACT.address}</li>
        </ul>
      </div>
    </div>

    <p class="site-footer__colophon">
      © {year} {BRAND.name}. Form submissions go to our inbox so we can
      build your draft — never sold, never added to a list you didn't ask
      for. <a href="/terms/">The free-build terms</a>, in plain English.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-ink);
    color: var(--footer-paper);
    padding-block: var(--space-6) var(--space-4);
    margin-top: var(--space-7);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 44rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1.4fr;
    }
  }

  .site-footer__wordmark {
    font-weight: 750;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .site-footer__tagline {
    margin-top: var(--space-2);
    color: var(--footer-faint);
    max-width: 32ch;
  }

  .site-footer__meta {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--footer-faint);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--footer-faint);
    margin-bottom: var(--space-3);
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer li + li {
    margin-top: var(--space-2);
  }

  .site-footer a {
    color: var(--footer-paper);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__address {
    font-size: var(--text-sm);
    color: var(--footer-faint);
  }

  .site-footer__colophon {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--text-xs);
    color: var(--footer-faint);
    max-width: 72ch;
  }

  .site-footer__colophon a {
    color: var(--footer-paper);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
