---
// Body for /services/landing-pages/ — landing & campaign pages.
import { PRICING } from '../../config';

const pkg = PRICING.find((p) => p.id === 'one-page');
---

<section class="section section--rule">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Who this is for</span>
      <h2>One service to push. One offer to run. One season to win.</h2>
      <p class="lede">
        A landing page does a single job: take a visitor who arrived for one
        reason and make contacting you the obvious next step. Use one to
        spotlight your most profitable service, run a seasonal offer, or give
        the traffic you're already paying for a page that respects it.
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Deliverables</span>
      <h2>What a landing page includes</h2>
    </div>
    <div class="grid grid--2">
      <ul class="checklist">
        <li>One custom-designed page around one clear offer</li>
        <li>Copywriting included — you talk, I write, you approve</li>
        <li>Click-to-call and a short form, nothing to scroll past</li>
        <li>Fast static build, tested on real phones</li>
      </ul>
      <ul class="checklist">
        <li>Analytics and conversion tracking wired to your accounts</li>
        <li>Basic on-page SEO: title, description, structured data</li>
        <li>Hosting in your accounts, often at $0/month</li>
        <li>{pkg?.timeline ? `Delivered in ${pkg.timeline.replace(' from kickoff', '')} from kickoff` : 'Delivered on a written date'}</li>
      </ul>
    </div>
  </div>
</section>

<section class="section section--rule">
  <div class="container container--narrow">
    <div class="section-head">
      <span class="eyebrow">Questions</span>
      <h2>Asked often, answered straight.</h2>
    </div>
    <details class="faq">
      <summary>What does it cost?</summary>
      <div class="faq-body">
        <p>
          {pkg ? `${pkg.price}, ${pkg.priceNote}` : 'A flat, fixed quote'} —
          it's the {pkg?.name} package on the
          <a href="/pricing/">pricing page</a>.
        </p>
      </div>
    </details>
    <details class="faq">
      <summary>How is this different from a full website?</summary>
      <div class="faq-body">
        <p>
          A website introduces your whole business; a landing page sells one
          job type — AC replacements, a panel-upgrade special, seasonal
          gutter clean-outs. If you don't have a site at all, a one-pager can
          be both for a while — plenty of businesses start there and grow
          into a <a href="/services/web-design/">full site</a> later.
        </p>
      </div>
    </details>
    <details class="faq">
      <summary>Can you test two versions against each other?</summary>
      <div class="faq-body">
        <p>
          Yes — I build the variants and wire the measurement. True split
          testing runs on an analytics service, which lives in your account
          like everything else. I'll say plainly whether your traffic volume
          is enough for a test to mean anything; below a certain volume it's
          reading tea leaves.
        </p>
      </div>
    </details>
  </div>
</section>
